[
  {
    "legend": "Informasi kontak Anda",
    "columns": 3,
    "fields": [
      {
        "type": "text",
        "name": "first-name",
        "placeholder": "Nama depan",
        "autoComplete": "given-name",
        "required": true
      },
      {
        "type": "text",
        "name": "last-name",
        "placeholder": "Nama belakang",
        "autoComplete": "family-name",
        "required": true
      },
      {
        "type": "text",
        "name": "email",
        "placeholder": "Alamat email",
        "autoComplete": "email",
        "inputType": "email",
        "required": true
      },
      {
        "type": "text",
        "name": "company",
        "placeholder": "Nama perusahaan",
        "autoComplete": "company"
      },
      {
        "type": "text",
        "name": "phone",
        "placeholder": "Nomor telepon",
        "autoComplete": "phone"
      },
      {
        "type": "select",
        "name": "country",
        "autoComplete": "country-name",
        "defaultValue": "Select Country",
        "options": [
          {
            "label": "Pilih negara",
            "value": "",
            "disabled": true
          },
          {
            "label": "Indonesia",
            "value": "United States"
          },
          {
            "label": "Malaysia",
            "value": "Canada"
          },
          {
            "label": "Turki",
            "value": "Germany"
          },
          {
            "label": "Amerika",
            "value": "France"
          }
        ]
      }
    ]
  },
  {
    "legend": "Layanan apa yang Anda butuhkan untuk proyek Anda?",
    "columns": 3,
    "fields": [
      {
        "type": "checkbox",
        "name": "project-type[Website Development]",
        "label": "Pengembangan Website"
      },
      {
        "type": "checkbox",
        "name": "project-type[App Development]",
        "label": "Pengembangan Aplikasi"
      },
      {
        "type": "checkbox",
        "name": "project-type[Design System]",
        "label": "Sistem Desain"
      },
      {
        "type": "checkbox",
        "name": "project-type[Website Migration]",
        "label": "Migrasi Website"
      },
      {
        "type": "checkbox",
        "name": "project-type[E-commerce Site]",
        "label": "Website E-commerce"
      },
      {
        "type": "checkbox",
        "name": "project-type[Performance Evaluation]",
        "label": "Evaluasi Performa"
      }
    ]
  },
  {
    "legend": "Berapa perkiraan anggaran Anda?",
    "columns": 3,
    "fields": [
      {
        "type": "radio",
        "name": "budget",
        "value": "Less than $2,000",
        "label": "Kurang dari 20 Juta"
      },
      {
        "type": "radio",
        "name": "budget",
        "value": "$2,000 - $10,000",
        "label": "20 Juta - 200 Juta"
      },
      {
        "type": "radio",
        "name": "budget",
        "value": "More than $10,000",
        "label": "Lebih dari 200 Juta"
      }
    ]
  },
  {
    "legend": "Ceritakan tentang proyek Anda",
    "columns": 1,
    "fields": [
      {
        "type": "textarea",
        "name": "message",
        "placeholder": "Deskripsi proyek",
        "rows": 3
      }
    ]
  }
]
